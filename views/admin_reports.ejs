<head>
	<link rel="stylesheet" href="/css/settings.css">
	<link rel="stylesheet" href="/css/admin.css">
</head>

<script defer type="module" src="/js/admin_reports.js"></script>

<div class="admin-wrapper">
	<main class="admin-content">
		<header class="admin-header">
			<h1>REPORTS</h1>
			<a href="/admin" class="admin-nav-link">← PLACEHOLDERS</a>
		</header>

		<section class="section">
			<div class="report-list">
				<% if(reports.length === 0){ %>
					<p class="empty-state">No reports yet.</p>
				<% } %>

				<% reports.forEach(r => { %>
					<div class="report-row" data-report-id="<%= r.id %>" data-status="<%= r.status %>">
						<div class="report-info">
							<span class="report-status-badge status-<%= r.status %>"><%= r.status %></span>
							<span class="report-date"><%= new Date(r.created_at).toLocaleDateString() %></span>
						</div>

						<div class="report-parties">
							<div>
								<span class="report-label">Reported:</span>
								<a href="/u/<%= r.reported_username %>/settings"><%= r.reported_first_name %> <%= r.reported_last_name %> (@<%= r.reported_username %>)</a>
							</div>

							<div>
								<span class="report-label">Reporter:</span>
								<% if(r.reporter_username){ %>
									<span><%= r.reporter_first_name %> <%= r.reporter_last_name %> (@<%= r.reporter_username %>)</span>
								<% } else { %>
									<span class="empty-state">Unknown / deleted user</span>
								<% } %>
							</div>
						</div>

						<p class="report-reason"><%= r.reason %></p>

						<% if(r.status === "pending"){ %>
							<div class="report-actions">
								<button type="button" class="solid2-btn mark-reviewed-btn">MARK REVIEWED</button>
								<button type="button" class="solid-btn mark-dismissed-btn">DISMISS</button>
							</div>
						<% } %>
					</div>
				<% }) %>
			</div>
		</section>
	</main>
</div>
