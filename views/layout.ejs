<!DOCTYPE html>
<html lang="en" data-theme="light">
	<head>
		<!-- Fonts --> <!-- TODO: Remove unused -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">

		<meta charset="UTF-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= `STRIKR | ${title}` %></title>

		<!-- Global CSS -->
		<link rel="stylesheet" href="/css/variables.css">
		<link rel="stylesheet" href="/css/global.css">
		<link rel="stylesheet" href="/css/inputs.css">
		<link rel="stylesheet" href="/css/navbar.css">

		<meta name="description" content="<%= locals.og_description %>" />
		<link rel="canonical" href="<%= locals.canonical_url %>" />

		<meta property="og:site_name" content="STRIKR" />
		<meta property="og:title" content="<%= `STRIKR | ${title}` %>" />
		<meta property="og:description" content="<%= locals.og_description %>" />
		<meta property="og:image" content="<%= locals.og_image %>" />
		<meta property="og:url" content="<%= locals.canonical_url %>" />
		<meta property="og:type" content="website" />

		<!-- TODO: Swap to summary_large_image once a purpose-built 1200x630 share card exists;
		     the logo is square and gets cropped badly in a large card. -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="<%= `STRIKR | ${title}` %>" />
		<meta name="twitter:description" content="<%= locals.og_description %>" />
		<meta name="twitter:image" content="<%= locals.og_image %>" />
	</head>

	<body>
		<%- include("navbar") %>

		<!-- Main page content -->
		<%- body %>

		<dialog id="error-dialog" class="error-modal">
			<div class="error-content">
				<h4 id="error-context"></h4>
				<p id="error-message">HTTP <span id="error-code"></span> : <span id="error-text"></span></p>
			</div>
		</dialog>

		<!-- Global JS -->
		<script>
			//The id of the profile being viewed, which is not necessarily the viewer's own.
			const PROFILE_ID = <%- (typeof profile !== 'undefined' && profile?.id) ? JSON.stringify(profile.id) : 'null' %>;
		</script>

		<script type="module" defer src="/js/global.js"></script>
	</body>
</html>
