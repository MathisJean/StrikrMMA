<head>
    <link rel="stylesheet" href="/css/auth.css">
</head>

<script defer type="module" src="/js/auth.js"></script>

<!-- TODO: Terms & Services -->

<!-- Content -->
<section class="main-section">
	<div class="section-auth">
		<form class="auth" id="login-form" autocomplete="off" novalidate>
			<h1 class="auth-title">LOG IN</h1>
			<p class="auth-description">Welcome back to your corner.</p>

			<div class="auth-inputs">
				<label class="auth-label">
					EMAIL
					<input type="email" class="user-input" placeholder="you@exemple.com" autocomplete="email" oninvalid="let popup_alert = this.parentNode.querySelector('.alert_msg'); popup_alert.textContent = 'E-mail Invalide'; popup_alert.style.visibility = 'visible';">
				</label>
				
				<label class="auth-label">
					PASSWORD
					<input type="password" class="user-input" placeholder="··········" autocomplete="current-password" minlength="8" oninvalid="let popup_alert = this.parentNode.querySelector('.alert_msg'); popup_alert.textContent = 'Mot de Passe Trop Court'; popup_alert.style.visibility = 'visible';">
				</label>
			</div>
			
			<div class="auth-submit-wrap">
				<button type="submit" class="solid2-btn">ENTER</button>
			</div>

			<p class="auth-switch" id="login-switch">Don't have an account? <span>Join Now</span></p>
		</form>

		<form class="auth" id="signup-form" autocomplete="off" style="opacity: 0; pointer-events: none;" novalidate>
			<h1 class="auth-title">SIGN UP</h1>
			<p class="auth-description">Choose your corner.</p>	
			
			<div class="auth-inputs">
				<label class="auth-label" id="auth-corner">
					CORNER
					<div id="corner-radio">
						<input type="radio" for="corner-radio" name="input-corner" value="red">
						<input type="radio" for="corner-radio" name="input-corner" value="blue">
					</div>
				</label>

				<label class="auth-label">
					GIVEN NAME
					<input type="text" id="namef-input" class="user-input" data-status="n" placeholder="John" autocomplete="given-name">
				</label>

				<label class="auth-label">
					FAMILY NAME
					<input type="text" id="namel-input" class="user-input" data-status="n" placeholder="Doe" autocomplete="family-name">
				</label>

				<label class="auth-label">
					USERNAME
					<div class="input-wrapper">
						<span class="prefix">strikr.com/u/</span>
						<input type="text" id="username-input" class="user-input" data-status="n" placeholder="johndoe50" autocomplete="username">
						<span id="username-status" class="input-status"></span>
					</div>
				</label>

				<label class="auth-label">
					EMAIL
					<div class="input-wrapper">
						<input type="email" id="email-input" class="user-input" data-status="n" placeholder="johndoe@exemple.com" autocomplete="email">
						<span id="email-status" class="input-status"></span>
					</div>
				</label>
				
				<label class="auth-label">
					PASSWORD
					<div class="input-wrapper">
						<input type="password" id="password-input" class="user-input" data-status="n" placeholder="··········" autocomplete="current-password" minlength="8">
						<span id="password-status" class="input-status"></span>
					</div>
				</label>
			</div>

			<div class="auth-submit-wrap">
				<button type="submit" id="signup-btn" class="solid-btn">ENTER</button>
			</div>

			<p class="auth-switch" id="signup-switch">Already have an account? <span>Log In</span></p>
		</form>
	</div>

	<div class="section-visual">
		<div id="visual-login">
			<h1 class="visual-title">BACK INTO</h1>
			<h1 class="visual-title"><span>THE RING</span></h1>

			<p class="visual-description">Log in to your profile. Manage your fighter stats. Keep building your record. Show them you're ready.</p>
		</div>

		<div id="visual-signup">
			<h1 class="visual-title">STEP INTO</h1>
			<h1 class="visual-title"><span>THE RING</span></h1>

			<p class="visual-description">Create your fighter profile. Connect your Instagram. Share your record. Let the world know who you are.</p>
		</div>
	</div>
</section>