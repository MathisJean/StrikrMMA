<head>
    <link rel="stylesheet" href="/css/auth.css">
</head>

<script defer type="module" src="/js/auth.js"></script>

<!-- Content -->
<!--
	One form, one field. There is no login/signup distinction to slide between any more:
	the same email either finds an account or creates one, so the panel is static.
-->
<section class="main-section">
	<div class="section-auth">
		<form class="auth" id="request-form" autocomplete="on" novalidate>
			<h1 class="auth-title">LOGIN</h1>
			<p class="auth-description">Continue to login or to create an account.</p>

			<div class="auth-inputs">
				<label class="auth-label">
					EMAIL
					<div class="input-wrapper">
						<input type="email" id="email-input" class="user-input" placeholder="you@example.com" autocomplete="email" required>
					</div>
				</label>
			</div>

			<div class="auth-submit-wrap">
				<button type="submit" id="request-btn" class="solid2-btn">VERIFY EMAIL</button>
			</div>

			<p class="auth-switch">New here? Verify your email to start.</p>
		</form>

		<!--
			The second half of the same flow, not a second form. Both ways out of this screen
			are offered at once: clicking the link works when the mail app opens it in this
			same browser, and the code covers when it doesn't — an Instagram in-app browser
			can hand the link to a different browser entirely, leaving this tab logged out.
		-->
		<div class="auth auth-sent" id="sent-panel" hidden>
			<h1 class="auth-title">CHECK YOUR EMAIL</h1>
			<p class="auth-description">We sent a login link to <strong id="sent-email"></strong>.</p>

			<form id="code-form" autocomplete="off" novalidate>
				<div class="auth-inputs">
					<label class="auth-label">
						LOGIN CODE
						<div class="input-wrapper">
							<input type="text" id="code-input" class="user-input" placeholder="000000" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}">
						</div>
					</label>
				</div>

				<div class="auth-submit-wrap">
					<button type="submit" id="code-btn" class="solid2-btn">LOG IN</button>
				</div>
			</form>

			<p class="auth-switch">Didn't get it? <span id="resend-btn">Send another link</span></p>
			<p class="auth-switch" id="auth-expiry">The link and code expire in 15 minutes.</p>
		</div>
	</div>

	<div class="section-visual">
		<div id="visual-login">
			<h1 class="visual-title">BACK INTO</h1>
			<h1 class="visual-title"><span>THE RING</span></h1>

			<p class="visual-description">Manage your fighter stats. Keep building your record. Show them you're ready.</p>
		</div>
	</div>
</section>
