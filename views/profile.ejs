<head>
    <link rel="stylesheet" href="/css/profile.css">   
    <script defer src="/js/profile.js"></script>
</head>

<style>
	html{
		--corner: var(<%= locals.corner === 'red' ? '--red' : '--blue' %>);
	}
</style>

<script defer>
	document.addEventListener("DOMContentLoaded", () => {
        const report_btn = document.getElementById("report-btn");

        report_btn?.addEventListener("click", async (event) => {
            const profile_id = <%- JSON.stringify(profile.id) %>;

			const reason = prompt("Why are you reporting this profile?");
			if(!reason || !reason.trim()) return;

			const response = await fetch(`/report/${profile_id}`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ reason: reason.trim() })
			});

			const data = await response.json().catch(() => ({}));

			if(!response.ok){
				show_error("Report Failed", response.status, data.error || "Profile has failed to be reported");
				return;
			}

			show_error("Report Created", "201", "Profile has been reported", true, false)
			const span = report_btn.querySelector("span")
			const computed_styles = window.getComputedStyle(span);

			const transition_time = computed_styles.getPropertyValue('--transition-time').trim();

			span.style.opacity = 0;

			setTimeout(() => {
				span.textContent = "REPORTED";
				span.style.opacity = 1;
			}, transition_time);
		});
    });
</script>

<div class="page">
	<% if(!is_owner){ %>
	<button id="report-btn" class="solid-btn" style="pointer-events: <%= has_reported || !is_login ? 'none' : 'all' %>;">
		<img src="/svg/report.svg">

		<% if(has_reported){ %>
		<span>REPORTED</span>
		<% }else if(!is_login){ %>
		<span>LOGIN TO REPORT</span>
		<% }else{ %>
		<span>REPORT</span>
		<% } %>
	</button>
	<% } %>

	<section class="hero <%= profile?.profile_picture_url ? 'has-profile-picture' : '' %> <%= profile?.profile_banner_url ? 'has-banner-picture' : '' %>" style="--bg-mobile: url('<%= profile?.profile_picture_url %>'); --bg-desktop: url('<%= profile?.profile_banner_url %>');">
		<% if(is_owner){ %>
			<div class="owner-btn">
				<a id="setting-btn" href="<%= user.username ? `/u/${user.username}/settings` : '/home' %>">
					<svg xmlns="http://www.w3.org/2000/svg" height="28px" width="28px" viewBox="0 -960 960 960" fill="#FFFFFF"><path d="m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm112-260q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Z"/></svg>
				</a>

				<div id="logout-btn">
					<svg xmlns="http://www.w3.org/2000/svg" height="28px" width="28px" viewBox="0 -960 960 960" fill="#FFFFFF">
						<!-- Main body of the icon -->
						<path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Z"/>
						
						<!-- Arrow part -->
						<path id="arrow" d="M640-280l-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z"/>
					</svg>
				</div>
			</div>
		<% } %>

		<div class="hero-content">	
			<% if(profile.nickname){ %>
				<h2 id="hero-nickname">"<%= profile.nickname %>"</h2>
			<% } %>

			<h1 id="hero-title" class="fighter-profiles-hero-title hero-title">
				<%= profile.first_name %>
				<%= profile.last_name %>
			</h1>

			<div class="credentials-badges">
				<% for(let i = 0; i < badges.martial_arts.length; i++){ %>
					<div class="badge"><%= badges.martial_arts[i].name %></div>
				<% } %>

				<% for(let i = 0; i < badges.weight_classes.length; i++){ %>
					<div class="badge"><%= badges.weight_classes[i].name %></div>
				<% } %>
			</div>
		</div>

		<div class="profile-img <%= profile.profile_picture_url ? 'custom' : 'default' %>" style="background-image: <%= profile.profile_picture_url ? `url(${profile.profile_picture_url});` : 'url(/svg/profile_light.svg);' %>">
	</section>

	<section class="content">
		<div class="actions-wrapper">
			<div class="content-actions">
				<div aria-label="Verified fighter profile" class="<%= corner == 'red' ? 'solid-btn' : 'solid2-btn' %> verified-badge <%= !profile.verified ? 'hidden' : '' %>">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
						<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
							<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77a4 4 0 0 1 6.74 0a4 4 0 0 1 4.78 4.78a4 4 0 0 1 0 6.74a4 4 0 0 1-4.77 4.78a4 4 0 0 1-6.75 0a4 4 0 0 1-4.78-4.77a4 4 0 0 1 0-6.76"></path>
							<path d="m9 12l2 2l4-4"></path>
						</g>
					</svg>
					<span>Verified</span>
				</div>

				<% if(is_beta_tester){ %>
				<button aria-label="Instagram" class=<%= corner == "red" ? "solid-btn" : "solid2-btn" %> onclick="window.open('https://instagram.com/<%= profile.instagram_url %>', '_blank')">
					<img src="/svg/test.svg">

					<span>Beta Tester</span>
				</button>
				<% } %>

				<% if(is_founding_member){ %>
				<button aria-label="Instagram" class=<%= corner == "red" ? "solid-btn" : "solid2-btn" %> onclick="window.open('https://instagram.com/<%= profile.instagram_url %>', '_blank')">
					<img src="/svg/star.svg">

					<span>Founding Member</span>
				</button>
				<% } %>

				<% if(profile.instagram_url){ %>
				<button aria-label="Instagram" class=<%= corner == "red" ? "solid-btn" : "solid2-btn" %> onclick="window.open('https://instagram.com/<%= profile.instagram_url %>', '_blank')">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 22 22" role="img" aria-label="Instagram">
						<title>Instagram</title>
						<rect x="3" y="3" width="18" height="18" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2"/>
						<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
						<circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
					</svg>

					<span>Follow</span>
				</button>
				<% } %>

				<button aria-label="Share" class=<%= corner == "red" ? "solid-btn" : "solid2-btn" %> onclick="copy_link()">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share2 lucide-share-2 size-4" aria-hidden="true">
						<circle cx="18" cy="5" r="3"></circle>
						<circle cx="6" cy="12" r="3"></circle>
						<circle cx="18" cy="19" r="3"></circle>
						<line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
						<line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
					</svg>
				
					<span>Share</span>
				</button>
			</div>

			<div class="content-tags">
				<% for(let i = 0; i < tags.length; i++){ %>
					<div class="tag <%= corner == 'red' ? 'solid-btn' : 'solid2-btn' %>"><%= tags[i].tag_text %></div>
				<% } %>
			</div>
		</div>

		<div class="content-sections">
			<div class="section-specs" data-accordion-section>
				<h3 class="accordion-header" role="button" tabindex="0" data-accordion-toggle aria-expanded="true">
					THE SPECS
					<span class="accordion-chevron" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
					</span>
				</h3>
				<div class="accordion-body">
					<div class="accordion-body-inner">
						<div class="specs-details">
							<% if(profile.date_of_birth){ %> <div><span>AGE</span><span><%= calculate_age(profile.date_of_birth) %></span></div> <% } %>
							<% if(profile.height){ %> <div><span>HEIGHT</span><span><%= calculate_height(profile.height) %></span></div> <% } %>
							<% if(profile.stance){ %> <div><span>STANCE</span><span><%= profile.stance %></span></div> <% } %>
							<% if(profile.team){ %> <div><span>TEAM</span><span><%= profile.team %></span></div> <% } %>
							<% if(profile.hometown){ %> <div><span>HOMETOWN</span><span><%= profile.hometown %></span></div> <% } %>
							<% if(corner){ %> <div><span>CORNER</span><span><%= corner %></span></div> <% } %>
							<% if(profile.walkout_song && profile.walkout_song_artist){ %> <div><span>ANTHEM</span><span><%= profile.walkout_song %>, <%= profile.walkout_song_artist %></span></div> <% } %>
						</div>
					</div>
				</div>
			</div>

			<div class="section-numbers" data-accordion-section>
				<h3 class="accordion-header" role="button" tabindex="0" data-accordion-toggle aria-expanded="false">
					THE NUMBERS
					<span class="accordion-chevron" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
					</span>
				</h3>
				<div class="accordion-body">
					<div class="accordion-body-inner">
						<div class="numbers-details">
							<div class="details-stat">
								<div class="stat-bar">
									<div class="bar-visual" style="width: <%= (record.wins / (record.total_fights == 0 ? 1 : record.total_fights)) * 100 %>%;"></div>
								</div>
								<h4 class="details-description"><%= record.wins %> WINS</h4>
							</div>

							<div class="details-stat">
								<div class="stat-bar">
									<div class="bar-visual" style="width: <%= (record.losses / (record.total_fights == 0 ? 1 : record.total_fights)) * 100 %>%;"></div>
								</div>
								<h4 class="details-description"><%= record.losses %> LOSSES</h4>
							</div>

							<div class="details-stat">
								<div class="stat-bar">
									<div class="bar-visual" style="width: <%= (record.draws / (record.total_fights == 0 ? 1 : record.total_fights)) * 100 %>%;"></div>
								</div>
								<h4 class="details-description"><%= record.draws %> DRAWS</h4>
							</div>

							<div class="details-stat">
								<div class="stat-bar">
									<div class="bar-visual" style="width: <%= (record.ko / (record.total_fights == 0 ? 1 : record.total_fights)) * 100 %>%;"></div>
								</div>
								<h4 class="details-description"><%= record.ko %> KO/TKO</h4>
							</div>

							<div class="details-stat">
								<div class="stat-bar">
									<div class="bar-visual" style="width: <%= (record.submissions / (record.total_fights == 0 ? 1 : record.total_fights)) * 100 %>%;"></div>
								</div>
								<h4 class="details-description"><%= record.submissions %> SUB</h4>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="section-timeline" data-accordion-section>
				<h3 class="accordion-header" role="button" tabindex="0" data-accordion-toggle aria-expanded="false">
					THE STORY
					<span class="accordion-chevron" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
					</span>
				</h3>
				<div class="accordion-body">
					<div class="accordion-body-inner">
						<div class="timeline-details">
							<% for(let i = 0; i < awards.length; i++){ %>
								<div class="details-award">
									<h5 class="award-year"><%= calculate_year(awards[i].date_earned) %></h5>
									<h4 class="award-title"><%= awards[i].title %></h4>
									<p class="award-description"><%= awards[i].description %></p>
								</div>
							<% } %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</div>