<head>
	<link rel="stylesheet" href="/css/auth.css">
	<link rel="stylesheet" href="/css/steps.css">
	<link rel="stylesheet" href="/css/onboarding.css">
	<link rel="stylesheet" href="/css/claim.css">
</head>

<script defer type="module" src="/js/claim.js"></script>

<!-- Content -->
<section class="main-section claim-section">
	<div class="section-visual">
		<div id="visual-claim">
			<h1 class="visual-title">CLAIM YOUR</h1>
			<h1 class="visual-title"><span>CORNER</span></h1>

			<p class="visual-description">Every champion started in a corner nobody knew. Claim it now, defend it forever.</p>
		</div>
	</div>

	<div class="section-auth claim-panel">
		<% if(state === "ready"){ %>
			<!--
				The claim token authorises exactly two things: viewing this preview, and
				answering "is this you". It proves nothing about who owns the address typed
				in at Step 2, so it never creates a session — Step 2 sends an ordinary magic
				link, and clicking THAT is what proves the address and logs the athlete in.
			-->
			<div class="auth onboarding" id="claim-flow" data-token="<%= token %>">
				<p class="step-indicator" data-step-indicator></p>

				<div class="step-viewport">
					<div class="step-track" id="claim-track">

						<!-- Step 1 — Is this you? -->
						<div class="step-panel" data-step="1">
							<h1 class="auth-title">CLAIM YOUR PROFILE</h1>
							<p class="auth-description">Is this you, <%= profile.first_name %> <%= profile.last_name %>?</p>

							<div class="step-actions">
								<button type="button" class="solid-btn" data-target-step="2">THIS IS ME</button>
							</div>

							<p class="auth-switch"><span id="claim-decline-btn">Decline this profile</span></p>
						</div>

						<!-- Step 2 — Email -->
						<div class="step-panel" data-step="2">
							<h1 class="auth-title">SIGNUP</h1>
							<p class="auth-description">Continue to claim this account.</p>

							<div class="auth-inputs">
								<label class="auth-label">
									EMAIL
									<div class="input-wrapper">
										<input type="email" id="email-input" class="user-input" data-status="n" placeholder="johndoe@example.com" autocomplete="email">
										<span id="email-status" class="input-status"></span>
									</div>
								</label>
							</div>

							<div class="step-actions">
								<button type="button" class="solid2-btn" data-target-step="1">BACK</button>
								<button type="button" class="solid-btn" id="claim-send-btn">VERIFY EMAIL</button>
							</div>
						</div>

						<!-- Step 3 — Check your email -->
						<div class="step-panel" data-step="3">
							<h1 class="auth-title">CHECK YOUR EMAIL</h1>
							<p class="auth-description">We sent a login link to <strong id="sent-email"></strong>.</p>

							<form id="code-form" autocomplete="off" novalidate>
								<div class="auth-inputs">
									<label class="auth-label">
										LOGIN CODE
										<div class="input-wrapper">
											<input type="text" id="code-input" class="user-input" placeholder="000000" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}">
										</div>
									</label>
								</div>

								<div class="auth-submit-wrap">
									<button type="submit" id="code-btn" class="solid2-btn">LOG IN</button>
								</div>
							</form>

							<p class="auth-switch">Didn't get it? <span id="resend-btn">Send another link</span></p>
							<p class="auth-switch" id="auth-expiry">The link and code expire in 15 minutes.</p>
						</div>

					</div>
				</div>
			</div>
		<% } else if(state === "already_claimed"){ %>
			<div class="auth claim-message">
				<h1 class="auth-title">ALREADY CLAIMED</h1>
				<p class="auth-description">This profile has already been claimed.</p>

				<div class="auth-submit-wrap">
					<a id="claim-home-btn" class="solid-btn" href="/home">GO HOME</a>
				</div>

				<div class="auth-submit-wrap claim-redirct-wrap">
					<p class="auth-switch claim-redirect">If this is your account, <a href="/auth">log in</a> instead.</p>
				</div>
			</div>
		<% } else{ %>
			<div class="auth claim-message">
				<h1 class="auth-title">LINK NOT FOUND</h1>
				<p class="auth-description">This link is invalid or is expired.</p>

				<div class="auth-submit-wrap">
					<a id="claim-home-btn" class="solid-btn" href="/home">GO HOME</a>
				</div>

				<div class="auth-submit-wrap claim-redirct-wrap">
					<p class="auth-switch claim-redirect"><a href="mailto:info@strikrmma.com">Contact us </a> if you believe this is a mistake.</p>
				</div>
			</div>
		<% } %>
	</div>
</section>
